# Database (active connection used by the app)
DATABASE_URL=postgresql://...

# Environment-specific DB URLs — not read by the app, used for ops scripts
# e.g: DATABASE_URL="$(grep DATABASE_URL_BETA .env.local | cut -d= -f2-)" npx prisma migrate resolve ...
DATABASE_URL_BETA=postgresql://...     # Neon branch: main    → beta.fantasy.dykedb.org
DATABASE_URL_STAGING=postgresql://...  # Neon branch: preview → fantasydev.dykedb.org
DATABASE_URL_PROD=postgresql://...     # Neon branch: main    → fantasy.dykedb.org

# Auth cookie domain (set to ".dykedb.org" in production)
COOKIE_DOMAIN=

# PostHog analytics
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Draft WebSocket server
NEXT_PUBLIC_DRAFT_WS_URL=ws://localhost:8080

# Dev / staging controls
ALLOW_SIM_DATE=true

# Beta lockdown (set to the production hostname to restrict it)
BETA_HOST=
BETA_SITE_HOST=

# Founder console (comma-separated email list)
FOUNDER_EMAILS=

# Cron auth secret
CRON_SECRET=
